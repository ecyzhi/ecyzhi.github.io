---
import type { ToolIcon } from '../data/tools';
interface Props {
  icon: ToolIcon;
  active?: boolean;
}
const { icon, active = false } = Astro.props;
const color = active ? 'var(--accent)' : 'var(--icon)';
---
{icon === 'json' ? (
  <span class="glyph" style={`color:${color}`} aria-hidden="true">{'{ }'}</span>
) : (
  <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke={color} stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    {icon === 'circle' && (<><circle cx="12" cy="12" r="8" stroke-dasharray="3 2" /><circle cx="12" cy="12" r="3" /></>)}
    {icon === 'vector' && (<><path d="M12 3l7 7-5 9H10L5 10z" /><circle cx="12" cy="11" r="1.6" /></>)}
    {icon === 'collage' && (<><rect x="3" y="3" width="18" height="18" rx="2" /><path d="M12 3v18M3 12h9" /></>)}
    {icon === 'jwt' && (<><circle cx="8" cy="15" r="4" /><path d="M11 12l8-8M16 7l2 2M14 9l2 2" /></>)}
    {icon === 'encode' && (<><path d="M8 7l-5 5 5 5M16 7l5 5-5 5M14 4l-4 16" /></>)}
    {icon === 'clock' && (<><circle cx="12" cy="12" r="8.5" /><path d="M12 7v5l3 2" /></>)}
    {icon === 'pixel' && (<><path d="M4 4h5v5H4zM15 4h5v5h-5zM9.5 9.5h5v5h-5zM4 15h5v5H4zM15 15h5v5h-5z" /></>)}
    {icon === 'ascii' && (<><rect x="3" y="4" width="18" height="16" rx="2" /><path d="M7 9h2M11 9h6M7 12h6M15 12h2M7 15h3M12 15h2" /></>)}
    {icon === 'loan' && (<><rect x="4" y="3" width="16" height="18" rx="2" /><path d="M8 7h8M8 11h2M14 11h2M8 15h2M14 15h2" /></>)}
  </svg>
)}
<style>
  .glyph {
    font-family: var(--font-mono);
    font-size: 20px;
    font-weight: 700;
    line-height: 28px;
  }
</style>
