---
import { site } from '../data/site';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = [
  { href: '/', label: 'tools', match: '/' },
  { href: '/about/', label: 'about', match: '/about' },
];
// "tools" is current on the home page and on every tool page.
const isCurrent = (match: string) =>
  match === '/' ? path === '/' || path.startsWith('/tools/') : path === match || path.startsWith(match + '/');
---
<header class="site-header">
  <div class="wrap bar">
    <a href="/" class="home mono" aria-label={`${site.handle}, home (${site.name})`}>ecyzhi<span class="dot">.</span></a>
    <div class="actions">
    <nav class="links mono" aria-label="Main">
      {links.map((l) => (
        <a href={l.href} aria-current={isCurrent(l.match) ? 'page' : undefined}>{l.label}</a>
      ))}
      <a href="/resume/" class="cta" aria-current={isCurrent('/resume') ? 'page' : undefined}>resume.pdf</a>
    </nav>
    <button type="button" class="theme-toggle" data-pref="system" aria-label="Theme: follow system" title="Theme: follow system">
      <svg class="i-system" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="8.5"></circle><path d="M12 3.5v17a8.5 8.5 0 0 0 0-17z" fill="currentColor"></path></svg>
      <svg class="i-light" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
      <svg class="i-dark" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.5 14.5A8.5 8.5 0 1 1 9.5 3.5a7 7 0 0 0 11 11z"></path></svg>
    </button>
    <details class="menu">
      <summary aria-label="Menu">
        <svg class="open" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
        <svg class="close" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
      </summary>
      <nav class="sheet mono" aria-label="Main">
        {links.map((l) => (
          <a href={l.href} aria-current={isCurrent(l.match) ? 'page' : undefined}>{l.label}</a>
        ))}
        <a href="/resume/" class="cta">resume.pdf</a>
      </nav>
    </details>
    </div>
  </div>
</header>

<script>
  // Theme toggle cycles: follow system -> the opposite of the system theme ->
  // the system theme -> follow system, so every click visibly changes something
  // except the last, which hands control back to the OS. The icon shows the
  // current setting. The initial theme is applied by the inline script in
  // Base.astro, which also keeps "system" in sync with the OS.
  type Pref = 'system' | 'light' | 'dark';
  const w = window as unknown as { __setTheme: (t: Pref) => void; __themePref: () => Pref };
  const names: Record<Pref, string> = { system: 'follow system', light: 'light', dark: 'dark' };
  const mq = window.matchMedia('(prefers-color-scheme: light)');
  const nextPref = (pref: Pref): Pref => {
    const os: Pref = mq.matches ? 'light' : 'dark';
    const other: Pref = os === 'light' ? 'dark' : 'light';
    return pref === 'system' ? other : pref === other ? os : 'system';
  };
  const toggle = document.querySelector<HTMLButtonElement>('.site-header .theme-toggle');
  const sync = () => {
    if (!toggle) return;
    const pref = w.__themePref();
    toggle.dataset.pref = pref;
    toggle.setAttribute('aria-label', `Theme: ${names[pref]}. Switch to ${names[nextPref(pref)]}`);
    toggle.title = `Theme: ${names[pref]}`;
  };
  sync();
  window.addEventListener('themechange', sync);
  mq.addEventListener('change', sync);
  toggle?.addEventListener('click', () => w.__setTheme(nextPref(w.__themePref())));

  // Close the mobile menu after following an in-page link.
  document.querySelectorAll<HTMLAnchorElement>('.site-header .sheet a').forEach((a) =>
    a.addEventListener('click', () => a.closest('details')?.removeAttribute('open'))
  );
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--header-bg);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line-soft);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
  }
  .home {
    display: flex;
    align-items: center;
    padding: 6px 0;
    color: var(--text);
    text-decoration: none;
    font-size: 18px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .home:hover {
    color: var(--text);
  }
  .home .dot {
    color: var(--accent);
  }
  .links {
    display: flex;
    gap: 28px;
    align-items: center;
    font-size: 14px;
  }
  .links a,
  .sheet a {
    color: var(--muted);
    text-decoration: none;
  }
  .links a:hover,
  .links a[aria-current='page'],
  .sheet a[aria-current='page'] {
    color: var(--text);
  }
  .links .cta,
  .sheet .cta {
    color: var(--on-accent);
    background: var(--accent-fill);
    padding: 8px 14px;
    border-radius: 8px;
    font-weight: 700;
  }
  .links .cta:hover {
    background: var(--accent-fill-hover);
    color: var(--on-accent);
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .theme-toggle {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    background: transparent;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    color: var(--muted);
    cursor: pointer;
    transition: color 0.15s, border-color 0.15s, background-color 0.15s;
  }
  .theme-toggle:hover {
    color: var(--text);
    border-color: var(--line-strong);
    background: var(--surface);
  }
  .theme-toggle svg {
    display: none;
  }
  .theme-toggle[data-pref='system'] .i-system,
  .theme-toggle[data-pref='light'] .i-light,
  .theme-toggle[data-pref='dark'] .i-dark {
    display: block;
  }
  .menu {
    display: none;
    position: relative;
  }
  .menu summary {
    list-style: none;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    cursor: pointer;
  }
  .menu summary::-webkit-details-marker {
    display: none;
  }
  .menu .close,
  .menu[open] .open {
    display: none;
  }
  .menu[open] .close {
    display: block;
  }
  .sheet {
    position: absolute;
    right: 0;
    top: 54px;
    min-width: 200px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 8px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    box-shadow: 0 16px 40px var(--shadow-strong);
    font-size: 15px;
  }
  .sheet a {
    padding: 12px;
    border-radius: 8px;
  }
  .sheet a:not(.cta):hover {
    background: var(--surface-2);
  }
  .sheet .cta {
    margin-top: 4px;
    text-align: center;
  }
  @media (max-width: 640px) {
    .links {
      display: none;
    }
    .menu {
      display: block;
    }
    .actions {
      gap: 8px;
    }
    .theme-toggle {
      width: 44px;
      height: 44px;
      background: var(--surface);
    }
  }
</style>
