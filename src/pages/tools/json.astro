---
import Base from '../../layouts/Base.astro';
import JsonTools from '../../tools/json/JsonTools';

const steps = [
  { n: '01', title: 'Add JSON', body: 'Paste it, type it, open a .json file, or drop one on the input. It is checked as you type.' },
  { n: '02', title: 'Fix or explore', body: 'Errors show the line, column and what went wrong. Switch to Tree to fold the data and copy any path.' },
  { n: '03', title: 'Take it with you', body: 'Pick pretty or minified, indent and key order, then copy the result or download it as a file.' },
];
const faqs = [
  { q: 'Is my JSON sent anywhere?', a: 'No. Everything runs in your browser, on your device. Nothing is uploaded or stored, so API responses and config files with secrets stay private.' },
  { q: 'Will formatting change my numbers or text?', a: 'No. Numbers and strings are kept exactly as written, so big IDs like 12345678901234567890 keep every digit and escapes such as \\u00e9 stay as they are. Only whitespace changes, plus key order if you turn on Sort keys.' },
  { q: 'What counts as valid JSON?', a: 'Strict JSON: double-quoted strings and keys, no comments, no trailing commas, and no NaN, Infinity or undefined. The checker tells you which of these it found and where.' },
  { q: 'What does the path in Tree view mean?', a: 'It points at the value you tapped, written the way JavaScript and most JSONPath tools read it, for example $.tools[0].slug. Copy it into code, jq filters or tests.' },
  { q: 'How big a file can it handle?', a: 'Files of several megabytes work fine. Very large outputs are shown without colours to keep scrolling smooth, and the tree opens big arrays a page at a time.' },
];
---
<Base
  title="JSON tools"
  description="Format, validate, minify and explore JSON in a tree. Clear error messages with line and column. Free, works on phone and desktop, and your data never leaves your device."
>
  <div class="wrap page">
    <nav aria-label="Breadcrumb" class="crumbs mono"><a href="/tools/">tools</a> / <span aria-current="page">json</span></nav>
    <div class="head">
      <div>
        <h1>JSON tools</h1>
        <p class="lede">Format, validate, minify and explore JSON, with errors you can actually fix.</p>
      </div>
      <div class="privacy">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2"></rect><path d="M8 11V7a4 4 0 0 1 8 0v4"></path></svg>
        Runs on your device. Nothing is uploaded.
      </div>
    </div>

    <JsonTools client:only="react">
      <div slot="fallback" class="loading card">
        <noscript>This tool needs JavaScript turned on.</noscript>
        <span class="mono">loading editor…</span>
      </div>
    </JsonTools>

    <section class="how" aria-labelledby="how">
      <h2 id="how">How it works</h2>
      <ol class="steps">
        {steps.map((s) => (
          <li class="step">
            <div class="n mono">{s.n}</div>
            <div class="t">{s.title}</div>
            <div class="b">{s.body}</div>
          </li>
        ))}
      </ol>
    </section>

    <section class="faq" aria-labelledby="faq">
      <h2 id="faq">Questions</h2>
      {faqs.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </section>
  </div>
</Base>

<style>
  .page {
    max-width: 1200px;
    padding-top: 32px;
    padding-bottom: 88px;
  }
  .crumbs {
    font-size: 13px;
    color: var(--faint);
    margin-bottom: 16px;
  }
  .crumbs a {
    color: var(--faint);
    text-decoration: none;
  }
  .crumbs a:hover {
    color: var(--text);
  }
  .crumbs span {
    color: var(--text);
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 16px;
    margin-bottom: 28px;
  }
  h1 {
    font-size: clamp(28px, 4vw, 40px);
    margin-bottom: 8px;
  }
  .head .lede {
    max-width: 560px;
  }
  .privacy {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 12px;
    border: 1px solid var(--line);
    border-radius: 99px;
    font-size: 13px;
    color: var(--muted);
  }
  .loading {
    min-height: 420px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--faint);
    font-size: 13px;
    gap: 12px;
  }
  .how,
  .faq {
    margin-top: 56px;
  }
  h2 {
    font-size: 20px;
    margin-bottom: 16px;
  }
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }
  .step {
    padding: 18px;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }
  .n {
    color: var(--accent);
    font-size: 13px;
    margin-bottom: 8px;
  }
  .t {
    font-weight: 600;
    margin-bottom: 4px;
  }
  .b {
    color: var(--muted);
    font-size: 14px;
    line-height: 1.5;
  }
  .faq details {
    border-top: 1px solid var(--line);
    padding: 4px 0;
  }
  .faq details:last-child {
    border-bottom: 1px solid var(--line);
  }
  .faq summary {
    cursor: pointer;
    padding: 14px 0;
    font-weight: 500;
    list-style: none;
    display: flex;
    justify-content: space-between;
    gap: 16px;
  }
  .faq summary::-webkit-details-marker {
    display: none;
  }
  .faq summary::after {
    content: '+';
    font-family: var(--font-mono);
    color: var(--accent);
  }
  .faq details[open] summary::after {
    content: '−';
  }
  .faq p {
    color: var(--muted);
    padding: 0 0 16px;
    max-width: 720px;
    line-height: 1.6;
  }
  @media (max-width: 640px) {
    .steps {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
