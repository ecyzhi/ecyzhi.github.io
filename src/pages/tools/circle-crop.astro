---
import Base from '../../layouts/Base.astro';
import CircleCrop from '../../tools/circle-crop/CircleCrop';

const steps = [
  { n: '01', title: 'Add an image', body: 'Choose a file, drop it on the page, or paste it. Photos from your camera roll work too.' },
  { n: '02', title: 'Frame it', body: 'Pick circle or oval, then drag, pinch or scroll until it sits right. Rotate if you need to.' },
  { n: '03', title: 'Download', body: 'Get a PNG with transparent corners, ready for profile pictures, stickers and slides.' },
];
const faqs = [
  { q: 'Is my image uploaded anywhere?', a: 'No. The image is opened and cropped by your browser, on your device. Nothing is sent to a server, and closing the tab clears it.' },
  { q: 'Why PNG?', a: 'PNG keeps transparency, so the area outside the circle or oval stays see-through instead of turning white or black.' },
  { q: 'Which size should I pick?', a: '1024 px suits most profile pictures. Original resolution keeps every pixel of the area you framed, up to 4096 px.' },
  { q: 'It won\'t open my photo.', a: 'Your browser has to be able to read the format. JPG, PNG, WebP and GIF work everywhere; HEIC photos open in Safari, or export them as JPG first.' },
];
---
<Base
  title="Circle & oval crop"
  description="Crop any image to a circle or oval and download a transparent PNG. Free, works on phone and desktop, and your image never leaves your device."
>
  <div class="wrap page">
    <nav aria-label="Breadcrumb" class="crumbs mono"><a href="/">tools</a> / <span aria-current="page">circle-crop</span></nav>
    <div class="head">
      <div>
        <h1>Circle &amp; oval crop</h1>
        <p class="lede">Crop any image to a circle or oval and download a transparent PNG.</p>
      </div>
      <div class="privacy">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2"></rect><path d="M8 11V7a4 4 0 0 1 8 0v4"></path></svg>
        Runs on your device. Nothing is uploaded.
      </div>
    </div>

    <CircleCrop client:only="react">
      <div slot="fallback" class="loading card">
        <noscript>This tool needs JavaScript turned on.</noscript>
        <span class="mono">loading editor…</span>
      </div>
    </CircleCrop>

    <section class="how" aria-labelledby="how">
      <h2 id="how">How it works</h2>
      <ol class="steps">
        {steps.map((s) => (
          <li class="step">
            <div class="n mono">{s.n}</div>
            <div class="t">{s.title}</div>
            <div class="b">{s.body}</div>
          </li>
        ))}
      </ol>
    </section>

    <section class="faq" aria-labelledby="faq">
      <h2 id="faq">Questions</h2>
      {faqs.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </section>
  </div>
</Base>

<style>
  .page {
    max-width: 1200px;
    padding-top: 32px;
    padding-bottom: 88px;
  }
  .crumbs {
    font-size: 13px;
    color: var(--faint);
    margin-bottom: 16px;
  }
  .crumbs a {
    color: var(--faint);
    text-decoration: none;
  }
  .crumbs a:hover {
    color: var(--text);
  }
  .crumbs span {
    color: var(--text);
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 16px;
    margin-bottom: 28px;
  }
  h1 {
    font-size: clamp(28px, 4vw, 40px);
    margin-bottom: 8px;
  }
  .head .lede {
    max-width: 560px;
  }
  .privacy {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 12px;
    border: 1px solid var(--line);
    border-radius: 99px;
    font-size: 13px;
    color: var(--muted);
  }
  /* Roughly the editor's height, capped at the screen, so nothing below
     jumps when it loads. */
  .loading {
    min-height: min(994px, 100svh);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--faint);
    font-size: 13px;
    gap: 12px;
  }
  @media (min-width: 860px) {
    .loading {
      min-height: min(630px, 100svh);
    }
  }
  .how,
  .faq {
    margin-top: 56px;
  }
  h2 {
    font-size: 20px;
    margin-bottom: 16px;
  }
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }
  .step {
    padding: 18px;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }
  .n {
    color: var(--accent);
    font-size: 13px;
    margin-bottom: 8px;
  }
  .t {
    font-weight: 600;
    margin-bottom: 4px;
  }
  .b {
    color: var(--muted);
    font-size: 14px;
    line-height: 1.5;
  }
  .faq details {
    border-top: 1px solid var(--line);
    padding: 4px 0;
  }
  .faq details:last-child {
    border-bottom: 1px solid var(--line);
  }
  .faq summary {
    cursor: pointer;
    padding: 14px 0;
    font-weight: 500;
    list-style: none;
    display: flex;
    justify-content: space-between;
    gap: 16px;
  }
  .faq summary::-webkit-details-marker {
    display: none;
  }
  .faq summary::after {
    content: '+';
    font-family: var(--font-mono);
    color: var(--accent);
  }
  .faq details[open] summary::after {
    content: '−';
  }
  .faq p {
    color: var(--muted);
    padding: 0 0 16px;
    max-width: 720px;
    line-height: 1.6;
  }
  @media (max-width: 640px) {
    .steps {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
