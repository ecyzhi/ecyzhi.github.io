---
import Base from '../../layouts/Base.astro';
import JwtDecoder from '../../tools/jwt/JwtDecoder';

const steps = [
  { n: '01', title: 'Paste a token', body: 'Drop in a JWT, or a whole "Bearer …" header. It decodes as you type.' },
  { n: '02', title: 'Read it', body: 'See the header and payload as JSON or as a claims list, with dates in your time zone and a live expiry countdown.' },
  { n: '03', title: 'Check the signature', body: 'Optional: enter the secret, or paste a public key (PEM or JWK), to confirm the token hasn\'t been changed.' },
];
const faqs = [
  { q: 'Is my token sent anywhere?', a: 'No. Decoding and signature checks run in your browser, on your device. Nothing is sent to a server or saved, and closing the tab clears it.' },
  { q: 'Does decoding prove a token is genuine?', a: 'No. Anyone can read or write a JWT\'s header and payload; they are only base64url encoded. Only a signature check with the right secret or public key shows it hasn\'t been changed.' },
  { q: 'Which algorithms can it verify?', a: 'HS256/384/512 with a shared secret, and RS, PS and ES 256/384/512 with a public key as PEM (BEGIN PUBLIC KEY) or JWK. A JWK set works too; the key is picked by the token\'s kid. EdDSA works in browsers that support Ed25519.' },
  { q: 'What about encrypted tokens (JWE)?', a: 'A token with five parts is encrypted. Its header is shown, but the payload can only be read with the private key, which this tool doesn\'t ask for.' },
];
---
<Base
  title="JWT decoder"
  description="Decode a JSON Web Token to see its header, payload and expiry, and check its signature. Free, works on phone and desktop, and your token never leaves your device."
>
  <div class="wrap page">
    <nav aria-label="Breadcrumb" class="crumbs mono"><a href="/">tools</a> / <span aria-current="page">jwt</span></nav>
    <div class="head">
      <div>
        <h1>JWT decoder</h1>
        <p class="lede">See a JSON Web Token&rsquo;s header, payload and expiry, and check its signature.</p>
      </div>
      <div class="privacy">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2"></rect><path d="M8 11V7a4 4 0 0 1 8 0v4"></path></svg>
        Runs on your device. Nothing is uploaded.
      </div>
    </div>

    <JwtDecoder client:only="react">
      <div slot="fallback" class="loading card">
        <noscript>This tool needs JavaScript turned on.</noscript>
        <span class="mono">loading editor…</span>
      </div>
    </JwtDecoder>

    <section class="how" aria-labelledby="how">
      <h2 id="how">How it works</h2>
      <ol class="steps">
        {steps.map((s) => (
          <li class="step">
            <div class="n mono">{s.n}</div>
            <div class="t">{s.title}</div>
            <div class="b">{s.body}</div>
          </li>
        ))}
      </ol>
    </section>

    <section class="faq" aria-labelledby="faq">
      <h2 id="faq">Questions</h2>
      {faqs.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </section>
  </div>
</Base>

<style>
  .page {
    max-width: 1200px;
    padding-top: 32px;
    padding-bottom: 88px;
  }
  .crumbs {
    font-size: 13px;
    color: var(--faint);
    margin-bottom: 16px;
  }
  .crumbs a {
    color: var(--faint);
    text-decoration: none;
  }
  .crumbs a:hover {
    color: var(--text);
  }
  .crumbs span {
    color: var(--text);
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 16px;
    margin-bottom: 28px;
  }
  h1 {
    font-size: clamp(28px, 4vw, 40px);
    margin-bottom: 8px;
  }
  .head .lede {
    max-width: 560px;
  }
  .privacy {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 12px;
    border: 1px solid var(--line);
    border-radius: 99px;
    font-size: 13px;
    color: var(--muted);
  }
  .loading {
    min-height: 320px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--faint);
    font-size: 13px;
    gap: 12px;
  }
  .how,
  .faq {
    margin-top: 56px;
  }
  h2 {
    font-size: 20px;
    margin-bottom: 16px;
  }
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }
  .step {
    padding: 18px;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }
  .n {
    color: var(--accent);
    font-size: 13px;
    margin-bottom: 8px;
  }
  .t {
    font-weight: 600;
    margin-bottom: 4px;
  }
  .b {
    color: var(--muted);
    font-size: 14px;
    line-height: 1.5;
  }
  .faq details {
    border-top: 1px solid var(--line);
    padding: 4px 0;
  }
  .faq details:last-child {
    border-bottom: 1px solid var(--line);
  }
  .faq summary {
    cursor: pointer;
    padding: 14px 0;
    font-weight: 500;
    list-style: none;
    display: flex;
    justify-content: space-between;
    gap: 16px;
  }
  .faq summary::-webkit-details-marker {
    display: none;
  }
  .faq summary::after {
    content: '+';
    font-family: var(--font-mono);
    color: var(--accent);
  }
  .faq details[open] summary::after {
    content: '−';
  }
  .faq p {
    color: var(--muted);
    padding: 0 0 16px;
    max-width: 720px;
    line-height: 1.6;
  }
  @media (max-width: 640px) {
    .steps {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
