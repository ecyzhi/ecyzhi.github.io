---
import Base from '../../layouts/Base.astro';
import Encoder from '../../tools/encode/Encoder';

const steps = [
  { n: '01', title: 'Pick a format', body: 'Base64, URL (percent) encoding, or HTML entities. Then choose encode or decode.' },
  { n: '02', title: 'Type or paste', body: 'The result updates as you type. For Base64 you can also choose a file and get its Base64 or a data URL.' },
  { n: '03', title: 'Copy it out', body: 'Copy the result, save it as a text file, or flip it back into the input to check it round-trips.' },
];
const faqs = [
  { q: 'Is my text sent anywhere?', a: 'No. Encoding and decoding run in your browser, on your device. Nothing is sent to a server, and closing the tab clears it.' },
  { q: 'Which characters does it support?', a: 'All of Unicode. Text is read as UTF-8, so accents, Chinese, Japanese and emoji encode and decode correctly.' },
  { q: 'What is URL-safe Base64?', a: 'A Base64 variant that uses - and _ instead of + and /, and drops the = padding, so it fits in URLs and file names. JWTs use it. Decoding accepts both kinds either way.' },
  { q: 'What does "Whole URL" change?', a: 'Off, it encodes a single piece such as a query value, so / ? & = and # are escaped too. On, it encodes a full address and leaves those characters alone.' },
  { q: 'My Base64 decodes to a file.', a: 'When the decoded bytes aren\'t readable text, such as an image or PDF, you get a preview where possible and a button to download the file.' },
];
---
<Base
  title="Encode & decode"
  description="Encode and decode Base64, URL percent-encoding and HTML entities. Free, works on phone and desktop, and your text never leaves your device."
>
  <div class="wrap page">
    <nav aria-label="Breadcrumb" class="crumbs mono"><a href="/">tools</a> / <span aria-current="page">encode</span></nav>
    <div class="head">
      <div>
        <h1>Encode &amp; decode</h1>
        <p class="lede">Base64, URL encoding and HTML entities, both ways, as you type.</p>
      </div>
      <div class="privacy">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2"></rect><path d="M8 11V7a4 4 0 0 1 8 0v4"></path></svg>
        Runs on your device. Nothing is uploaded.
      </div>
    </div>

    <Encoder client:only="react">
      <div slot="fallback" class="loading card">
        <noscript>This tool needs JavaScript turned on.</noscript>
        <span class="mono">loading editor…</span>
      </div>
    </Encoder>

    <section class="how" aria-labelledby="how">
      <h2 id="how">How it works</h2>
      <ol class="steps">
        {steps.map((s) => (
          <li class="step">
            <div class="n mono">{s.n}</div>
            <div class="t">{s.title}</div>
            <div class="b">{s.body}</div>
          </li>
        ))}
      </ol>
    </section>

    <section class="faq" aria-labelledby="faq">
      <h2 id="faq">Questions</h2>
      {faqs.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </section>
  </div>
</Base>

<style>
  .page {
    max-width: 1200px;
    padding-top: 32px;
    padding-bottom: 88px;
  }
  .crumbs {
    font-size: 13px;
    color: var(--faint);
    margin-bottom: 16px;
  }
  .crumbs a {
    color: var(--faint);
    text-decoration: none;
  }
  .crumbs a:hover {
    color: var(--text);
  }
  .crumbs span {
    color: var(--text);
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 16px;
    margin-bottom: 28px;
  }
  h1 {
    font-size: clamp(28px, 4vw, 40px);
    margin-bottom: 8px;
  }
  .head .lede {
    max-width: 560px;
  }
  .privacy {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 12px;
    border: 1px solid var(--line);
    border-radius: 99px;
    font-size: 13px;
    color: var(--muted);
  }
  .loading {
    min-height: 420px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--faint);
    font-size: 13px;
    gap: 12px;
  }
  .how,
  .faq {
    margin-top: 56px;
  }
  h2 {
    font-size: 20px;
    margin-bottom: 16px;
  }
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }
  .step {
    padding: 18px;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }
  .n {
    color: var(--accent);
    font-size: 13px;
    margin-bottom: 8px;
  }
  .t {
    font-weight: 600;
    margin-bottom: 4px;
  }
  .b {
    color: var(--muted);
    font-size: 14px;
    line-height: 1.5;
  }
  .faq details {
    border-top: 1px solid var(--line);
    padding: 4px 0;
  }
  .faq details:last-child {
    border-bottom: 1px solid var(--line);
  }
  .faq summary {
    cursor: pointer;
    padding: 14px 0;
    font-weight: 500;
    list-style: none;
    display: flex;
    justify-content: space-between;
    gap: 16px;
  }
  .faq summary::-webkit-details-marker {
    display: none;
  }
  .faq summary::after {
    content: '+';
    font-family: var(--font-mono);
    color: var(--accent);
  }
  .faq details[open] summary::after {
    content: '−';
  }
  .faq p {
    color: var(--muted);
    padding: 0 0 16px;
    max-width: 720px;
    line-height: 1.6;
  }
  @media (max-width: 640px) {
    .steps {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
