---
import Base from '../../layouts/Base.astro';
import LoanCalculator from '../../tools/loan/LoanCalculator';

const steps = [
  { n: '01', title: 'Pick the loan type', body: 'Reducing balance for home and personal loans, flat rate for car hire purchase.' },
  { n: '02', title: 'Enter the numbers', body: 'Price, down payment, yearly interest rate and term. Results update as you type.' },
  { n: '03', title: 'Read the schedule', body: 'See each year or month of payments, then download the full schedule as CSV.' },
];
const faqs = [
  { q: 'What is the difference between reducing balance and flat rate?', a: 'A reducing-balance loan charges interest on what you still owe, so each month more of your payment goes to the loan itself. A flat-rate loan, common for car hire purchase in Malaysia, charges interest on the full amount for the whole term. That is why a 2.8% flat rate costs about as much as a 5% reducing rate; the calculator shows this as the effective rate.' },
  { q: 'How is the flat-rate schedule split between principal and interest?', a: 'Total interest is the amount financed × rate × years, spread evenly across instalments. Each instalment\'s interest share follows the Rule of 78, which hire-purchase agreements use: more interest early on, less near the end. It matters if you settle early.' },
  { q: 'What does an extra monthly payment do?', a: 'On a reducing-balance loan, anything above the instalment goes straight to the balance, so you pay less interest and finish sooner. Check that your bank allows it without a fee, and whether it needs to go into a separate account to count.' },
  { q: 'Are these figures exact?', a: 'They are estimates. Banks may round each instalment, charge interest daily, or add fees, insurance and stamp duty, so your offer letter can differ slightly.' },
  { q: 'Is anything I type saved or sent?', a: 'Nothing is sent anywhere. Your last inputs are kept in this browser so they are still there next time; clearing site data removes them.' },
];
---
<Base
  title="Loan calculator"
  description="Work out monthly payments, total interest and a full amortisation schedule for home, personal and car loans. Defaults to RM, works with other currencies, and runs on your device."
>
  <div class="wrap page">
    <nav aria-label="Breadcrumb" class="crumbs mono"><a href="/">tools</a> / <span aria-current="page">loan</span></nav>
    <div class="head">
      <div>
        <h1>Loan calculator</h1>
        <p class="lede">Monthly payments, total interest and a full schedule for home, personal and car loans.</p>
      </div>
      <div class="privacy">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2"></rect><path d="M8 11V7a4 4 0 0 1 8 0v4"></path></svg>
        Runs on your device. Nothing is uploaded.
      </div>
    </div>

    <LoanCalculator client:only="react">
      <div slot="fallback" class="loading card">
        <noscript>This tool needs JavaScript turned on.</noscript>
        <span class="mono">loading calculator…</span>
      </div>
    </LoanCalculator>

    <section class="how" aria-labelledby="how">
      <h2 id="how">How it works</h2>
      <ol class="steps">
        {steps.map((s) => (
          <li class="step">
            <div class="n mono">{s.n}</div>
            <div class="t">{s.title}</div>
            <div class="b">{s.body}</div>
          </li>
        ))}
      </ol>
    </section>

    <section class="faq" aria-labelledby="faq">
      <h2 id="faq">Questions</h2>
      {faqs.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </section>
  </div>
</Base>

<style>
  .page {
    max-width: 1200px;
    padding-top: 32px;
    padding-bottom: 88px;
  }
  .crumbs {
    font-size: 13px;
    color: var(--faint);
    margin-bottom: 16px;
  }
  .crumbs a {
    color: var(--faint);
    text-decoration: none;
  }
  .crumbs a:hover {
    color: var(--text);
  }
  .crumbs span {
    color: var(--text);
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 16px;
    margin-bottom: 28px;
  }
  h1 {
    font-size: clamp(28px, 4vw, 40px);
    margin-bottom: 8px;
  }
  .head .lede {
    max-width: 560px;
  }
  .privacy {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 12px;
    border: 1px solid var(--line);
    border-radius: 99px;
    font-size: 13px;
    color: var(--muted);
  }
  /* Roughly the editor's height, capped at the screen, so nothing below
     jumps when it loads. */
  .loading {
    min-height: min(2089px, 100svh);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--faint);
    font-size: 13px;
    gap: 12px;
  }
  @media (min-width: 860px) {
    .loading {
      min-height: min(1303px, 100svh);
    }
  }
  .how,
  .faq {
    margin-top: 56px;
  }
  h2 {
    font-size: 20px;
    margin-bottom: 16px;
  }
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }
  .step {
    padding: 18px;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }
  .n {
    color: var(--accent);
    font-size: 13px;
    margin-bottom: 8px;
  }
  .t {
    font-weight: 600;
    margin-bottom: 4px;
  }
  .b {
    color: var(--muted);
    font-size: 14px;
    line-height: 1.5;
  }
  .faq details {
    border-top: 1px solid var(--line);
    padding: 4px 0;
  }
  .faq details:last-child {
    border-bottom: 1px solid var(--line);
  }
  .faq summary {
    cursor: pointer;
    padding: 14px 0;
    font-weight: 500;
    list-style: none;
    display: flex;
    justify-content: space-between;
    gap: 16px;
  }
  .faq summary::-webkit-details-marker {
    display: none;
  }
  .faq summary::after {
    content: '+';
    font-family: var(--font-mono);
    color: var(--accent);
  }
  .faq details[open] summary::after {
    content: '−';
  }
  .faq p {
    color: var(--muted);
    padding: 0 0 16px;
    max-width: 720px;
    line-height: 1.6;
  }
  @media (max-width: 640px) {
    .steps {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
