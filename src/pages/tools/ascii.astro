---
import Base from '../../layouts/Base.astro';
import AsciiArt from '../../tools/ascii/AsciiArt';

const steps = [
  { n: '01', title: 'Add an image or video', body: 'Choose a file, drop it on the page, or paste an image. Photos and clips from your camera roll work too.' },
  { n: '02', title: 'Tune the look', body: 'Set how many characters wide it is, pick a character set, colour or mono, dark or light, and adjust contrast.' },
  { n: '03', title: 'Export', body: 'Copy the text or save it as .txt or .html, download a PNG, or record the video as ASCII with its sound.' },
];
const faqs = [
  { q: 'Is my file uploaded anywhere?', a: 'No. Your image or video is opened and converted by your browser, on your device. Nothing is sent to a server, and closing the tab clears it.' },
  { q: 'Why does recording a video take as long as the video?', a: 'The browser plays the video once and records each ASCII frame as it goes, so a one minute clip takes about a minute. Keep the tab open and on screen while it records, or the browser may pause it.' },
  { q: 'MP4 or WebM?', a: 'You get MP4 where the browser can record it, which includes Safari and recent Chrome and Edge. Other browsers record WebM, which plays in most browsers and video apps.' },
  { q: 'Can I keep the colours in the text?', a: 'Plain text has no colour, so .txt and Copy text are always mono. Download .html instead: it saves a web page where every character keeps its colour.' },
  { q: 'What are good settings?', a: 'Around 80 to 120 characters wide suits most photos. Use more for detailed pictures and fewer for a bolder look. Blocks gives smooth shading, Detailed gives the finest texture, and Invert helps when the subject is darker than its background.' },
];
---
<Base
  title="ASCII art converter"
  description="Turn any image or video into ASCII art. Export as text, HTML, PNG or a video, in colour or mono. Free, works on phone and desktop, and your files never leave your device."
>
  <div class="wrap page">
    <nav aria-label="Breadcrumb" class="crumbs mono"><a href="/">tools</a> / <span aria-current="page">ascii</span></nav>
    <div class="head">
      <div>
        <h1>ASCII art converter</h1>
        <p class="lede">Turn any image or video into ASCII art. Copy it as text, or save it as a PNG or a video.</p>
      </div>
      <div class="privacy">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2"></rect><path d="M8 11V7a4 4 0 0 1 8 0v4"></path></svg>
        Runs on your device. Nothing is uploaded.
      </div>
    </div>

    <AsciiArt client:only="react">
      <div slot="fallback" class="loading card">
        <noscript>This tool needs JavaScript turned on.</noscript>
        <span class="mono">loading editor…</span>
      </div>
    </AsciiArt>

    <section class="how" aria-labelledby="how">
      <h2 id="how">How it works</h2>
      <ol class="steps">
        {steps.map((s) => (
          <li class="step">
            <div class="n mono">{s.n}</div>
            <div class="t">{s.title}</div>
            <div class="b">{s.body}</div>
          </li>
        ))}
      </ol>
    </section>

    <section class="faq" aria-labelledby="faq">
      <h2 id="faq">Questions</h2>
      {faqs.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </section>
  </div>
</Base>

<style>
  .page {
    max-width: 1200px;
    padding-top: 32px;
    padding-bottom: 88px;
  }
  .crumbs {
    font-size: 13px;
    color: var(--faint);
    margin-bottom: 16px;
  }
  .crumbs a {
    color: var(--faint);
    text-decoration: none;
  }
  .crumbs a:hover {
    color: var(--text);
  }
  .crumbs span {
    color: var(--text);
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 16px;
    margin-bottom: 28px;
  }
  h1 {
    font-size: clamp(28px, 4vw, 40px);
    margin-bottom: 8px;
  }
  .head .lede {
    max-width: 560px;
  }
  .privacy {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 12px;
    border: 1px solid var(--line);
    border-radius: 99px;
    font-size: 13px;
    color: var(--muted);
  }
  /* Roughly the editor's height, capped at the screen, so nothing below
     jumps when it loads. */
  .loading {
    min-height: min(994px, 100svh);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--faint);
    font-size: 13px;
    gap: 12px;
  }
  @media (min-width: 860px) {
    .loading {
      min-height: min(630px, 100svh);
    }
  }
  .how,
  .faq {
    margin-top: 56px;
  }
  h2 {
    font-size: 20px;
    margin-bottom: 16px;
  }
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }
  .step {
    padding: 18px;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }
  .n {
    color: var(--accent);
    font-size: 13px;
    margin-bottom: 8px;
  }
  .t {
    font-weight: 600;
    margin-bottom: 4px;
  }
  .b {
    color: var(--muted);
    font-size: 14px;
    line-height: 1.5;
  }
  .faq details {
    border-top: 1px solid var(--line);
    padding: 4px 0;
  }
  .faq details:last-child {
    border-bottom: 1px solid var(--line);
  }
  .faq summary {
    cursor: pointer;
    padding: 14px 0;
    font-weight: 500;
    list-style: none;
    display: flex;
    justify-content: space-between;
    gap: 16px;
  }
  .faq summary::-webkit-details-marker {
    display: none;
  }
  .faq summary::after {
    content: '+';
    font-family: var(--font-mono);
    color: var(--accent);
  }
  .faq details[open] summary::after {
    content: '−';
  }
  .faq p {
    color: var(--muted);
    padding: 0 0 16px;
    max-width: 720px;
    line-height: 1.6;
  }
  @media (max-width: 640px) {
    .steps {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
