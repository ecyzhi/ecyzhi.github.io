---
import Base from '../../layouts/Base.astro';
import Pixelate from '../../tools/pixelate/Pixelate';

const steps = [
  { n: '01', title: 'Add an image', body: 'Choose a file, drop it on the page, or paste it. Photos from your camera roll work too.' },
  { n: '02', title: 'Pick what to hide', body: 'Pixelate the whole image, or switch to Brush and paint over faces, names or number plates.' },
  { n: '03', title: 'Set the strength and save', body: 'Drag Intensity for bigger or smaller blocks, then download the result as a PNG.' },
];
const faqs = [
  { q: 'Is my image uploaded anywhere?', a: 'No. The image is opened and pixelated by your browser, on your device. Nothing is sent to a server, and closing the tab clears it.' },
  { q: 'Can I change the intensity after painting?', a: 'Yes. The brushed areas are remembered, so moving the Intensity slider re-pixelates them with the new block size. Undo, Redo and Erase work the same way.' },
  { q: 'How do I zoom on a phone?', a: 'Pinch with two fingers to zoom and move around. In Brush mode one finger paints, so a second finger turns the stroke into a pinch instead.' },
  { q: 'Is pixelation safe for hiding private details?', a: 'Use a strong intensity for anything sensitive. Small blocks over short text, like a few digits, can sometimes be guessed back, so make the blocks bigger than the letters.' },
  { q: 'What size is the download?', a: 'The same size as your image, up to about 12 megapixels. Very large images are scaled down to keep the editor fast on phones.' },
];
---
<Base
  title="Pixelate image"
  description="Pixelate a whole image, or brush over faces and details to hide them, with adjustable intensity. Free, works on phone and desktop, and your image never leaves your device."
>
  <div class="wrap page">
    <nav aria-label="Breadcrumb" class="crumbs mono"><a href="/">tools</a> / <span aria-current="page">pixelate</span></nav>
    <div class="head">
      <div>
        <h1>Pixelate image</h1>
        <p class="lede">Pixelate the whole image, or brush over just the parts you want to hide. Pick the intensity and download a PNG.</p>
      </div>
      <div class="privacy">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2"></rect><path d="M8 11V7a4 4 0 0 1 8 0v4"></path></svg>
        Runs on your device. Nothing is uploaded.
      </div>
    </div>

    <Pixelate client:only="react">
      <div slot="fallback" class="loading card">
        <noscript>This tool needs JavaScript turned on.</noscript>
        <span class="mono">loading editor…</span>
      </div>
    </Pixelate>

    <section class="how" aria-labelledby="how">
      <h2 id="how">How it works</h2>
      <ol class="steps">
        {steps.map((s) => (
          <li class="step">
            <div class="n mono">{s.n}</div>
            <div class="t">{s.title}</div>
            <div class="b">{s.body}</div>
          </li>
        ))}
      </ol>
    </section>

    <section class="faq" aria-labelledby="faq">
      <h2 id="faq">Questions</h2>
      {faqs.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </section>
  </div>
</Base>

<style>
  .page {
    max-width: 1200px;
    padding-top: 32px;
    padding-bottom: 88px;
  }
  .crumbs {
    font-size: 13px;
    color: var(--faint);
    margin-bottom: 16px;
  }
  .crumbs a {
    color: var(--faint);
    text-decoration: none;
  }
  .crumbs a:hover {
    color: var(--text);
  }
  .crumbs span {
    color: var(--text);
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 16px;
    margin-bottom: 28px;
  }
  h1 {
    font-size: clamp(28px, 4vw, 40px);
    margin-bottom: 8px;
  }
  .head .lede {
    max-width: 560px;
  }
  .privacy {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 12px;
    border: 1px solid var(--line);
    border-radius: 99px;
    font-size: 13px;
    color: var(--muted);
  }
  /* Roughly the editor's height, capped at the screen, so nothing below
     jumps when it loads. */
  .loading {
    min-height: min(994px, 100svh);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--faint);
    font-size: 13px;
    gap: 12px;
  }
  @media (min-width: 860px) {
    .loading {
      min-height: min(630px, 100svh);
    }
  }
  .how,
  .faq {
    margin-top: 56px;
  }
  h2 {
    font-size: 20px;
    margin-bottom: 16px;
  }
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }
  .step {
    padding: 18px;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }
  .n {
    color: var(--accent);
    font-size: 13px;
    margin-bottom: 8px;
  }
  .t {
    font-weight: 600;
    margin-bottom: 4px;
  }
  .b {
    color: var(--muted);
    font-size: 14px;
    line-height: 1.5;
  }
  .faq details {
    border-top: 1px solid var(--line);
    padding: 4px 0;
  }
  .faq details:last-child {
    border-bottom: 1px solid var(--line);
  }
  .faq summary {
    cursor: pointer;
    padding: 14px 0;
    font-weight: 500;
    list-style: none;
    display: flex;
    justify-content: space-between;
    gap: 16px;
  }
  .faq summary::-webkit-details-marker {
    display: none;
  }
  .faq summary::after {
    content: '+';
    font-family: var(--font-mono);
    color: var(--accent);
  }
  .faq details[open] summary::after {
    content: '−';
  }
  .faq p {
    color: var(--muted);
    padding: 0 0 16px;
    max-width: 720px;
    line-height: 1.6;
  }
  @media (max-width: 640px) {
    .steps {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
