---
import Base from '../layouts/Base.astro';
import Experience from '../components/Experience.astro';
import Contact from '../components/Contact.astro';
import { skills } from '../data/experience';
import { tools } from '../data/tools';
import { site } from '../data/site';

const groups = [
  { label: 'frameworks', items: skills.frameworks, soft: false },
  { label: 'languages', items: skills.languages, soft: false },
  { label: 'tools', items: skills.tools, soft: true },
];
const liveTools = tools.filter((t) => t.live).map((t) => t.slug);
---
<Base title="About" description={site.description}>
  <section class="wrap hero">
    <div class="hero-grid">
      <div>
        <p class="eyebrow hello">// hello, my name is</p>
        <h1>{site.name}.</h1>
        <p class="intro">
          Software engineer in {site.location} building mobile and web apps with Flutter, plus the occasional free tool
          that runs right in your browser.
        </p>
        <div class="cta-row">
          <a class="btn btn-primary" href={site.resume} download>Download resume</a>
          <a class="btn btn-ghost" href="/">
            Browse tools
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
          </a>
        </div>
      </div>
      <div class="term mono" aria-hidden="true">
        <div class="dots"><span></span><span></span><span></span></div>
        <div class="term-body">
          <div><b>$</b> whoami</div>
          <div class="out">software engineer · flutter · web</div>
          <div><b>$</b> ls ./stack</div>
          <div class="out">flutter/ dart/ js/ .net/ firebase/</div>
          <div><b>$</b> ls ./tools --live</div>
          <div class="out">{liveTools.join('  ')}</div>
          <div><b>$</b> <span class="caret"></span></div>
        </div>
      </div>
    </div>
  </section>

  <section id="about" class="wrap section">
    <p class="eyebrow">01 / about</p>
    <div class="two">
      <div>
        <h2 class="section-title about-title">Beautiful interfaces, intuitive experiences</h2>
        <div class="body">
          <p class="lede">
            Located in {site.location}. I have built several frontend and backend applications throughout my career, from
            .NET APIs behind client dashboards to Flutter apps on phones and the web.
          </p>
          <p class="lede">
            I'm passionate about beautiful interfaces and creating intuitive user experiences. Currently, I'm focused on
            building mobile and web applications.
          </p>
          <p class="lede">
            This site is also where I keep small <a href="/">browser tools</a> I find useful. They run entirely on your
            device, so nothing you drop into them is uploaded anywhere.
          </p>
        </div>
      </div>
      <aside class="skills card">
        {groups.map((g) => (
          <div class="group">
            <div class="label mono">{g.label}</div>
            <div class="tags">
              {g.items.map((s) => <span class:list={['tag', { 'tag-soft': g.soft }]}>{s}</span>)}
            </div>
          </div>
        ))}
      </aside>
    </div>
  </section>

  <section id="experience" class="wrap section">
    <p class="eyebrow">02 / experience</p>
    <h2 class="section-title exp-title">Where I've worked</h2>
    <Experience />
  </section>

  <section id="contact" class="wrap section last">
    <Contact eyebrow="03 / contact" />
  </section>
</Base>

<style>
  .hero {
    padding-top: clamp(48px, 9vw, 88px);
    padding-bottom: 56px;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: 48px;
    align-items: center;
  }
  .hello {
    font-size: 14px;
    margin-bottom: 16px;
  }
  h1 {
    font-size: clamp(40px, 7vw, 76px);
    line-height: 1.02;
    letter-spacing: -0.03em;
    font-weight: 700;
  }
  .intro {
    margin-top: 20px;
    font-size: clamp(18px, 2.2vw, 22px);
    line-height: 1.5;
    color: var(--muted);
    max-width: 560px;
  }
  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }
  .term {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    font-size: 13px;
    line-height: 1.8;
  }
  .dots {
    display: flex;
    gap: 6px;
    padding: 12px 14px;
    border-bottom: 1px solid var(--line);
  }
  .dots span {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--line-strong);
  }
  .term-body {
    padding: 16px 18px;
    color: var(--muted);
  }
  .term-body b {
    color: var(--accent);
    font-weight: 400;
  }
  .out {
    color: var(--text);
  }
  .caret {
    display: inline-block;
    width: 8px;
    height: 15px;
    background: var(--accent);
    vertical-align: middle;
  }
  @media (prefers-reduced-motion: no-preference) {
    .caret {
      animation: blink 1.1s steps(1) infinite;
    }
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  .two {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    gap: 48px;
    align-items: start;
  }
  .about-title {
    margin-bottom: 16px;
  }
  .body {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .body .lede {
    margin: 0;
    line-height: 1.7;
  }
  .skills {
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .label {
    font-size: 13px;
    color: var(--faint);
    margin-bottom: 10px;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .skills .tag-soft {
    background: var(--surface-2);
  }
  .exp-title {
    margin-bottom: 24px;
  }
  .last {
    padding-bottom: 88px;
  }
  @media (max-width: 900px) {
    .hero-grid,
    .two {
      grid-template-columns: minmax(0, 1fr);
    }
    .term {
      display: none;
    }
  }
</style>
