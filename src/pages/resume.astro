---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---
<Base title="Resume" description="Resume of Yeap Lee Zhi, software engineer.">
  <section class="wrap page-top">
    <div class="head">
      <div>
        <p class="eyebrow">resume</p>
        <h1>Resume</h1>
        <p class="lede">One page, PDF. View it here or download a copy.</p>
      </div>
      <div class="actions">
        <a class="btn btn-primary" href={site.resume} download="Yeap-Lee-Zhi-Resume.pdf">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v11M7 10l5 5 5-5M5 20h14"></path></svg>
          Download PDF
        </a>
        <a class="btn btn-ghost" href={site.resume} target="_blank" rel="noopener">Open in new tab</a>
      </div>
    </div>
    <div class="viewer card">
      <object data={`${site.resume}#view=FitH`} type="application/pdf" aria-label="Resume PDF">
        <p class="fallback lede">
          Your browser can't show PDFs inline. <a href={site.resume}>Open the resume</a> instead.
        </p>
      </object>
    </div>
  </section>
</Base>
<style>
  .page-top {
    padding-top: clamp(40px, 7vw, 72px);
    padding-bottom: 72px;
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 20px;
    margin-bottom: 28px;
  }
  h1 {
    font-size: clamp(36px, 6vw, 56px);
    letter-spacing: -0.03em;
    margin-bottom: 8px;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .viewer {
    overflow: hidden;
    padding: 0;
    height: min(85vh, 1100px);
  }
  object {
    width: 100%;
    height: 100%;
    display: block;
  }
  .fallback {
    padding: 32px;
  }
  @media (max-width: 640px) {
    /* Mobile browsers rarely render PDFs inline; the buttons above do the job. */
    .viewer {
      display: none;
    }
  }
</style>
